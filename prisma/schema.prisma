// ERP RR — Prisma Schema
// Base de datos: Supabase (PostgreSQL)
// Generado: Chat 0 — Core

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN_GENERAL
  ADMINISTRACION
  TALLER
  INSTALACION
}

enum EstadoCliente {
  POR_VISITAR
  MEDICION_TOMADA
  PRESUPUESTO_ENVIADO
  PRESUPUESTO_ACEPTADO
  EN_PRODUCCION
  INSTALADO
}

enum TipoVisita {
  PRIMERA_MEDICION
  REMEDICION
  MUESTRA_TELAS
  ASESORAMIENTO
}

enum EstadoVisita {
  PROGRAMADA
  CONFIRMADA
  REALIZADA
  REPROGRAMADA
  CANCELADA
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  ACEPTADO_TOTAL
  ACEPTADO_PARCIAL
  RECHAZADO
}

enum EstadoComanda {
  PENDIENTE
  EN_PRODUCCION
  ESPERANDO_PROVEEDOR
  LISTO_PARA_INSTALAR
  INSTALADO
}

enum TipoItemComanda {
  FABRICAR
  PEDIR_PROVEEDOR
}

enum EstadoPedidoProveedor {
  PENDIENTE_PEDIDO
  PEDIDO_REALIZADO
  PEDIDO_RECIBIDO
}

enum EstadoInstalacion {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

enum TipoMovimientoStock {
  INGRESO
  EGRESO
  AJUSTE
}

enum EstadoOrdenCompra {
  PENDIENTE
  ENVIADA
  RECIBIDA_PARCIAL
  RECIBIDA_TOTAL
  CANCELADA
}

// ─── USUARIOS ────────────────────────────────────────────────────────────────

model Usuario {
  id            String   @id @default(uuid())
  supabaseId    String   @unique @map("supabase_id")
  nombre        String
  email         String   @unique
  rol           Rol      @default(ADMINISTRACION)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relaciones
  instaladorInstalaciones InstaladorInstalacion[]
  medicionesRealizadas    Medicion[]
  bloqueosAgenda          BloqueoAgenda[]
  visitasAsignadas        Visita[]

  @@map("usuarios")
}

// ─── CLIENTES ────────────────────────────────────────────────────────────────

model Cliente {
  id            String        @id @default(uuid())
  nombre        String
  telefono      String?
  email         String?
  direccion     String?
  localidad     String?
  notas         String?
  estado        EstadoCliente @default(POR_VISITAR)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  // Relaciones
  mediciones   Medicion[]
  presupuestos Presupuesto[]
  visitas      Visita[]

  @@map("clientes")
}

// ─── MEDICIONES (App PWA Offline) ────────────────────────────────────────────

model Medicion {
  id            String   @id @default(uuid())
  clienteId     String   @map("cliente_id")
  usuarioId     String   @map("usuario_id")
  observaciones String?
  sincronizado  Boolean  @default(false)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relaciones
  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  ambientes Ambiente[]

  @@map("mediciones")
}

model Ambiente {
  id         String   @id @default(uuid())
  medicionId String   @map("medicion_id")
  nombre     String // Ej: "Comedor", "Dormitorio principal"
  orden      Int      @default(0)
  creadoEn   DateTime @default(now()) @map("creado_en")

  // Relaciones
  medicion Medicion       @relation(fields: [medicionId], references: [id], onDelete: Cascade)
  items    ItemMedicion[]

  @@map("ambientes")
}

model ItemMedicion {
  id              String   @id @default(uuid())
  ambienteId      String   @map("ambiente_id")
  productoId      String?  @map("producto_id")
  descripcion     String // Nombre/tipo de cortina
  ancho           Decimal  @db.Decimal(9, 3)
  alto            Decimal  @db.Decimal(9, 3)
  cantidad        Int      @default(1)
  // Características específicas de cada ítem (JSON flexible por tipo)
  caracteristicas Json?
  observaciones   String?
  creadoEn        DateTime @default(now()) @map("creado_en")

  // Relaciones
  ambiente         Ambiente          @relation(fields: [ambienteId], references: [id], onDelete: Cascade)
  producto         Producto?         @relation(fields: [productoId], references: [id])
  itemsPresupuesto ItemPresupuesto[]
  itemsComanda     ItemComanda[]

  @@map("items_medicion")
}

// ─── PRESUPUESTOS ────────────────────────────────────────────────────────────

model Presupuesto {
  id            String            @id @default(uuid())
  clienteId     String            @map("cliente_id")
  numero        Int               @unique @default(autoincrement())
  estado        EstadoPresupuesto @default(BORRADOR)
  subtotal      Decimal           @default(0) @db.Decimal(12, 2)
  descuento     Decimal           @default(0) @db.Decimal(5, 2) // porcentaje
  total         Decimal           @default(0) @db.Decimal(12, 2)
  notas         String?
  validezDias   Int               @default(15) @map("validez_dias")
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  // Relaciones
  cliente Cliente           @relation(fields: [clienteId], references: [id])
  items   ItemPresupuesto[]
  comanda Comanda?

  @@map("presupuestos")
}

model ItemPresupuesto {
  id                 String    @id @default(uuid())
  presupuestoId      String    @map("presupuesto_id")
  itemMedicionId     String?   @map("item_medicion_id")
  descripcion        String
  ambiente           String? // Nombre del ambiente al que pertenece
  ancho              Decimal   @db.Decimal(9, 3)
  alto               Decimal   @db.Decimal(9, 3)
  cantidad           Int       @default(1)
  precioUnitario     Decimal   @map("precio_unitario") @db.Decimal(12, 2)
  subtotal           Decimal   @db.Decimal(12, 2)
  aceptado           Boolean   @default(false) // Para aceptación parcial / opción elegida
  // Alternativas de una misma cortina (ej: "Riel" / "Barral")
  // caracteristicas: especificación propia de la opción (null = usa la de la medición)
  caracteristicas    Json?
  grupoAlternativa   String?   @map("grupo_alternativa")
  nombreOpcion       String?   @map("nombre_opcion")
  esOpcionPrincipal  Boolean   @default(true) @map("es_opcion_principal")
  // Aviso para administración cuando la medición cambia después de presupuestar
  medidaAnterior     Json?     @map("medida_anterior")
  medidaModificadaEn DateTime? @map("medida_modificada_en")
  creadoEn           DateTime  @default(now()) @map("creado_en")

  // Relaciones
  presupuesto  Presupuesto   @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  itemMedicion ItemMedicion? @relation(fields: [itemMedicionId], references: [id])

  @@map("items_presupuesto")
}

// ─── COMANDAS ────────────────────────────────────────────────────────────────

model Comanda {
  id            String        @id @default(uuid())
  presupuestoId String        @unique @map("presupuesto_id")
  numero        Int           @unique @default(autoincrement())
  estado        EstadoComanda @default(PENDIENTE)
  notas         String?
  fechaEntrega  DateTime?     @map("fecha_entrega")
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  // Relaciones
  presupuesto Presupuesto   @relation(fields: [presupuestoId], references: [id])
  items       ItemComanda[]
  instalacion Instalacion?

  @@map("comandas")
}

model ItemComanda {
  id                 String          @id @default(uuid())
  comandaId          String          @map("comanda_id")
  productoId         String?         @map("producto_id")
  descripcion        String
  ambiente           String?
  ancho              Decimal         @db.Decimal(9, 3)
  alto               Decimal         @db.Decimal(9, 3)
  cantidad           Int             @default(1)
  tipo               TipoItemComanda @default(FABRICAR)
  caracteristicas    Json?
  observaciones      String?
  completado         Boolean         @default(false)
  // Vínculo con la cortina medida (para reflejar cambios de medición)
  itemMedicionId     String?         @map("item_medicion_id")
  // Aviso para administración cuando la medición cambia después de generar la comanda
  medidaAnterior     Json?           @map("medida_anterior")
  medidaModificadaEn DateTime?       @map("medida_modificada_en")
  creadoEn           DateTime        @default(now()) @map("creado_en")

  // Relaciones
  comanda      Comanda               @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  producto     Producto?             @relation(fields: [productoId], references: [id])
  itemMedicion ItemMedicion?         @relation(fields: [itemMedicionId], references: [id], onDelete: SetNull)
  pedidos      PedidoProveedorItem[]

  @@map("items_comanda")
}

// Pedido a proveedor de una capa de cortina (Gaza / B.O. / única) de un ítem de comanda
model PedidoProveedorItem {
  id            String                @id @default(uuid())
  itemComandaId String                @map("item_comanda_id")
  capa          String // "GAZA", "BO", "GAZA_BO" (misma marca) o "UNICA"
  marca         String? // Marca tomada de la medición (HD, RS, MG)
  proveedorId   String?               @map("proveedor_id")
  estado        EstadoPedidoProveedor @default(PENDIENTE_PEDIDO)
  fechaPedido   DateTime?             @map("fecha_pedido")
  fechaRecibido DateTime?             @map("fecha_recibido")
  nota          String?
  creadoEn      DateTime              @default(now()) @map("creado_en")
  actualizadoEn DateTime              @updatedAt @map("actualizado_en")

  itemComanda ItemComanda @relation(fields: [itemComandaId], references: [id], onDelete: Cascade)
  proveedor   Proveedor?  @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  @@unique([itemComandaId, capa])
  @@map("pedidos_proveedor_items")
}

// ─── PRODUCTOS / STOCK ────────────────────────────────────────────────────────

model Producto {
  id            String   @id @default(uuid())
  codigo        String?  @unique
  nombre        String
  descripcion   String?
  unidadMedida  String   @default("unidad") @map("unidad_medida") // unidad, metro, metro2, kg
  stockActual   Decimal  @default(0) @map("stock_actual") @db.Decimal(10, 2)
  stockMinimo   Decimal  @default(0) @map("stock_minimo") @db.Decimal(10, 2)
  precio        Decimal? @db.Decimal(12, 2) // precio de costo
  imagen        String? // Foto del producto / insumo
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relaciones
  itemsMedicion       ItemMedicion[]
  itemsComanda        ItemComanda[]
  movimientos         MovimientoStock[]
  itemsOrdenCompra    ItemOrdenCompra[]
  productoProveedores ProductoProveedor[]

  @@map("productos")
}

model MovimientoStock {
  id             String              @id @default(uuid())
  productoId     String              @map("producto_id")
  tipo           TipoMovimientoStock
  cantidad       Decimal             @db.Decimal(10, 2)
  stockAnterior  Decimal             @map("stock_anterior") @db.Decimal(10, 2)
  stockNuevo     Decimal             @map("stock_nuevo") @db.Decimal(10, 2)
  motivo         String?
  referenciaId   String?             @map("referencia_id") // ID de comanda, orden de compra, etc.
  referenciaTipo String?             @map("referencia_tipo")
  creadoEn       DateTime            @default(now()) @map("creado_en")

  // Relaciones
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("movimientos_stock")
}

// ─── PROVEEDORES ─────────────────────────────────────────────────────────────

model Proveedor {
  id            String   @id @default(uuid())
  nombre        String
  contacto      String?
  telefono      String?
  email         String?
  direccion     String?
  notas         String?
  activo        Boolean  @default(true)
  // Marcas de cortina que provee (HD, RS, MG) para preseleccionarlo en los pedidos
  marcas        String[] @default([])
  // Días habituales de entrega (para la alerta de pedido demorado)
  diasEntrega   Int?     @map("dias_entrega")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relaciones
  productos      ProductoProveedor[]
  ordenesCompra  OrdenCompra[]
  pedidosCortina PedidoProveedorItem[]
  listaPrecios   ListaPrecioItem[]

  @@map("proveedores")
}

// Categorías de la lista de precios (definen el recargo que se aplica al presupuestar)
enum CategoriaListaPrecio {
  SISTEMA
  ACCESORIO
  MOTORIZACION
  RIEL_MOTORIZADO
  TELA
  BANDAS_VERTICALES
  SERVICIO
}

// Ítem de la lista de precios de un proveedor (precio de lista, sin recargos)
model ListaPrecioItem {
  id            String               @id @default(uuid())
  proveedorId   String               @map("proveedor_id")
  categoria     CategoriaListaPrecio
  seccion       String // Subtítulo de la lista (ej: "Sistema Soft RS")
  descripcion   String
  colores       String? // Colores disponibles (lo que figura entre paréntesis)
  unidad        String // ml, m2, u, par
  precio        Decimal              @db.Decimal(12, 2)
  vendemos      Boolean              @default(false) // Lo que se ofrece en los presupuestos
  orden         Int                  @default(0)
  vigencia      String? // Ej: "Septiembre 2026"
  nota          String? // Aclaración de la sección (ej: "No incluye tela")
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now()) @map("creado_en")
  actualizadoEn DateTime             @updatedAt @map("actualizado_en")

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@unique([proveedorId, seccion, descripcion])
  @@index([proveedorId, categoria])
  @@map("lista_precios_items")
}

model ProductoProveedor {
  id              String   @id @default(uuid())
  productoId      String   @map("producto_id")
  proveedorId     String   @map("proveedor_id")
  codigoProveedor String?  @map("codigo_proveedor")
  precioUltimo    Decimal? @map("precio_ultimo") @db.Decimal(12, 2)
  esPrincipal     Boolean  @default(false) @map("es_principal")

  // Relaciones
  producto  Producto  @relation(fields: [productoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([productoId, proveedorId])
  @@map("productos_proveedores")
}

// ─── ÓRDENES DE COMPRA ────────────────────────────────────────────────────────

model OrdenCompra {
  id            String            @id @default(uuid())
  proveedorId   String            @map("proveedor_id")
  numero        Int               @unique @default(autoincrement())
  estado        EstadoOrdenCompra @default(PENDIENTE)
  notas         String?
  fotoRemito    String?           @map("foto_remito") // URL en Supabase Storage
  total         Decimal?          @db.Decimal(12, 2)
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  // Relaciones
  proveedor Proveedor         @relation(fields: [proveedorId], references: [id])
  items     ItemOrdenCompra[]

  @@map("ordenes_compra")
}

model ItemOrdenCompra {
  id               String   @id @default(uuid())
  ordenCompraId    String   @map("orden_compra_id")
  productoId       String   @map("producto_id")
  cantidadPedida   Decimal  @map("cantidad_pedida") @db.Decimal(10, 2)
  cantidadRecibida Decimal  @default(0) @map("cantidad_recibida") @db.Decimal(10, 2)
  precioUnitario   Decimal? @map("precio_unitario") @db.Decimal(12, 2)
  creadoEn         DateTime @default(now()) @map("creado_en")

  // Relaciones
  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto    Producto    @relation(fields: [productoId], references: [id])

  @@map("items_orden_compra")
}

// ─── INSTALACIONES / AGENDA ──────────────────────────────────────────────────

model Instalacion {
  id               String            @id @default(uuid())
  comandaId        String            @unique @map("comanda_id")
  fecha            DateTime
  horaInicio       String?           @map("hora_inicio")
  horaFin          String?           @map("hora_fin")
  estado           EstadoInstalacion @default(PROGRAMADA)
  notas            String?
  materialesListos Boolean           @default(false) @map("materiales_listos")
  creadoEn         DateTime          @default(now()) @map("creado_en")
  actualizadoEn    DateTime          @updatedAt @map("actualizado_en")

  // Relaciones
  comanda      Comanda                 @relation(fields: [comandaId], references: [id])
  instaladores InstaladorInstalacion[]

  @@map("instalaciones")
}

model InstaladorInstalacion {
  id            String @id @default(uuid())
  instalacionId String @map("instalacion_id")
  usuarioId     String @map("usuario_id")

  // Relaciones
  instalacion Instalacion @relation(fields: [instalacionId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@unique([instalacionId, usuarioId])
  @@map("instaladores_instalaciones")
}

model BloqueoAgenda {
  id            String   @id @default(uuid())
  usuarioId     String?  @map("usuario_id")
  fecha         DateTime
  horaInicio    String   @map("hora_inicio") // "10:00"
  horaFin       String   @map("hora_fin") // "12:00"
  motivo        String
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relaciones
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("bloqueos_agenda")
}

// ─── VISITAS (Agenda Comercial y Medición en Obra) ──────────────────────────

model Visita {
  id            String       @id @default(uuid())
  clienteId     String       @map("cliente_id")
  usuarioId     String       @map("usuario_id")
  fecha         DateTime
  horaInicio    String       @map("hora_inicio") // "15:00"
  horaFin       String       @map("hora_fin") // "16:30"
  tipoVisita    TipoVisita   @default(PRIMERA_MEDICION) @map("tipo_visita")
  estado        EstadoVisita @default(PROGRAMADA)
  direccion     String
  localidad     String?
  notas         String?
  googleEventId String?      @map("google_event_id")
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  // Relaciones
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("visitas")
}
